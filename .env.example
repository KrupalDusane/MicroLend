# Database Configuration
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Authentication
# Replace with a strong, random 256-bit base64 encoded string in production
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough
# Token expiration in milliseconds (e.g. 86400000 = 24 hours)
JWT_EXPIRATION=86400000
